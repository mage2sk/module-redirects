<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Interface bindings -->
    <preference for="Panth\Redirects\Api\RedirectMatcherInterface"
                type="Panth\Redirects\Model\Redirect\Matcher"/>

    <!-- Console commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="panth_redirects_import" xsi:type="object">Panth\Redirects\Console\Command\RedirectImportCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Grid Collections: real PHP classes extending SearchResult -->
    <type name="Panth\Redirects\Model\ResourceModel\Redirect\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">panth_seo_redirect</argument>
            <argument name="resourceModel" xsi:type="string">Panth\Redirects\Model\ResourceModel\Redirect</argument>
        </arguments>
    </type>
    <type name="Panth\Redirects\Model\ResourceModel\NotFoundLog\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">panth_seo_404_log</argument>
            <argument name="resourceModel" xsi:type="string">Panth\Redirects\Model\ResourceModel\NotFoundLog</argument>
        </arguments>
    </type>
    <type name="Panth\Redirects\Model\ResourceModel\NotFoundCluster\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">panth_seo_404_cluster</argument>
            <argument name="resourceModel" xsi:type="string">Panth\Redirects\Model\ResourceModel\NotFoundCluster</argument>
        </arguments>
    </type>

    <!-- Register grid data sources -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="panth_redirects_redirect_listing_data_source" xsi:type="string">Panth\Redirects\Model\ResourceModel\Redirect\Grid\Collection</item>
                <item name="panth_redirects_notfoundlog_listing_data_source" xsi:type="string">Panth\Redirects\Model\ResourceModel\NotFoundLog\Grid\Collection</item>
                <item name="panth_redirects_notfoundcluster_listing_data_source" xsi:type="string">Panth\Redirects\Model\ResourceModel\NotFoundCluster\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Panth\Redirects\Ui\RedirectGridFulltextFilter" type="Panth\Redirects\Ui\Component\Listing\LikeFulltextFilter">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="pattern" xsi:type="string">main_table.pattern</item>
                <item name="target" xsi:type="string">main_table.target</item>
                <item name="match_type" xsi:type="string">main_table.match_type</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\RedirectGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Panth\Redirects\Ui\RedirectGridFulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\RedirectGridReporting" type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Panth\Redirects\Ui\RedirectGridFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\RedirectGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Panth\Redirects\Ui\RedirectGridReporting</argument>
        </arguments>
    </virtualType>

    <virtualType name="Panth\Redirects\Ui\NotFoundLogGridFulltextFilter" type="Panth\Redirects\Ui\Component\Listing\LikeFulltextFilter">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="request_path" xsi:type="string">main_table.request_path</item>
                <item name="referer" xsi:type="string">main_table.referer</item>
                <item name="suggested_target" xsi:type="string">main_table.suggested_target</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundLogGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Panth\Redirects\Ui\NotFoundLogGridFulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundLogGridReporting" type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Panth\Redirects\Ui\NotFoundLogGridFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundLogGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Panth\Redirects\Ui\NotFoundLogGridReporting</argument>
        </arguments>
    </virtualType>

    <virtualType name="Panth\Redirects\Ui\NotFoundClusterGridFulltextFilter" type="Panth\Redirects\Ui\Component\Listing\LikeFulltextFilter">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="pattern" xsi:type="string">main_table.pattern</item>
                <item name="sample_url" xsi:type="string">main_table.sample_url</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundClusterGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Panth\Redirects\Ui\NotFoundClusterGridFulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundClusterGridReporting" type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Panth\Redirects\Ui\NotFoundClusterGridFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\Redirects\Ui\NotFoundClusterGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Panth\Redirects\Ui\NotFoundClusterGridReporting</argument>
        </arguments>
    </virtualType>
</config>
